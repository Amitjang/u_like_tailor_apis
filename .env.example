# ---------- App ----------
APP_ENV=dev                       # dev | prod
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000   # customer tracking link isi se banta hai
CORS_ORIGINS=*                    # prod: https://app.example.com,https://admin.example.com
RUN_WORKER=true                   # WhatsApp sender + reminders isi process mein

# ---------- Database (MongoDB) ----------
# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/uliketailor?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/uliketailor
# Link mein database ka naam (/uliketailor) zaroor rakhein — na ho to apne aap "uliketailor" use hota hai.

# ---------- Google / Apple login ----------
# Google Cloud Console > APIs & Services > Credentials: "Web application" client ka ID zaroor
# (Flutter app isi ko serverClientId bhejti hai), saath mein Android aur iOS client IDs bhi — comma se alag
GOOGLE_CLIENT_IDS=1234567890-web.apps.googleusercontent.com,1234567890-ios.apps.googleusercontent.com
# Apple: iOS app ka bundle id (Xcode > Runner > Signing). Android/web par Apple login ho to Services ID bhi
APPLE_CLIENT_IDS=com.uLikeTailor.uLikeTailor
ADMIN_EMAILS=                     # comma se alag; in emails wale login ko /api/admin/* milta hai

# ---------- Push notification (Firebase) ----------
# Firebase console > Project settings > Service accounts > "Generate new private key" (JSON file)
# Us JSON ko base64 karke ek line mein:  base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Deadline reminders (2 din / 1 din / aaj) worker se jaate hain — RUN_WORKER=true zaroori

# ---------- Login (OTP: ab sirf phone number jodne ke liye) ----------
JWT_SECRET=                       # openssl rand -hex 32
OTP_SECRET=                       # openssl rand -hex 32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=60d
DEV_FIXED_OTP=123456              # SIRF development. Production mein khaali!
OTP_PROVIDER=log                  # log | whatsapp
OTP_TEMPLATE_NAME=login_otp       # WhatsApp authentication template (hi + en dono approve karwayein)

# ---------- WhatsApp (Meta Cloud API) ----------
WA_PROVIDER=log                   # log (console par print) | meta_cloud
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=                    # webhook signature check
WA_VERIFY_TOKEN=                  # Meta dashboard mein webhook verify token
WA_API_VERSION=v20.0

# ---------- Subscription payment (Razorpay) ----------
PAYMENT_PROVIDER=                 # khaali = key ho to razorpay, warna band
RAZORPAY_KEY_ID=                  # rzp_test_... (test) / rzp_live_... (live)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # Dashboard > Webhooks mein jo secret daala
# RAZORPAY_BASE_URL=https://api.razorpay.com

# ---------- App admin (aap) ----------
ADMIN_PHONES=9876543210           # comma se alag; inhe /api/admin/* milta hai

# ---------- Photo upload (Cloudinary) ----------
# Khaali ho to /api/media/upload saaf message deta hai (baaki sab chalta hai)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
